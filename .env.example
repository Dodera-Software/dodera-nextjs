SITE_URL=https://doderasoft.com

# Postgres (server-only — no NEXT_PUBLIC_ prefix)
# e.g. postgresql://user:password@host:5432/dodera
DATABASE_URL=

# Prismic CMS (server-only — no NEXT_PUBLIC_ prefix)
PRISMIC_REPOSITORY_NAME=dodera-nextjs
PRISMIC_ACCESS_TOKEN=
PRISMIC_WRITE_TOKEN=

# OpenAI (server-only — no NEXT_PUBLIC_ prefix)
OPENAI_API_KEY=

# Admin quick-links (shown on dashboard — NEXT_PUBLIC so they reach the browser)
NEXT_PUBLIC_ADMIN_LINK_COOLIFY=
NEXT_PUBLIC_ADMIN_LINK_PRISMIC_MIGRATION=https://dodera-nextjs.prismic.io/builder/migration

# DODERA AUTO-POST (server-only — no NEXT_PUBLIC_ prefix)
# AUTO_POST_OPENAI_MODEL=gpt-4o

# Slack — incoming webhook for the #leads channel
SLACK_LEADS_WEBHOOK_URL=

# Zoho SMTP (outgoing email)
ZOHO_SMTP_PASSWORD=

# ADMIN JWT secret (server-only — no NEXT_PUBLIC_ prefix)
ADMIN_JWT_SECRET=

# Newsletter unsubscribe — HMAC-SHA256 secret used to sign/verify unsubscribe links.
UNSUBSCRIBE_TOKEN_SECRET=

# ── One-time Supabase → Postgres migration only ──────────────
# Needed by scripts/migrate-cvs-from-supabase.ts; remove afterwards.
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
